{
  "version": 2,
  "outputDirectory": "dist/public",
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/index.ts"
    }
  ],
  "functions": {
    "src/index.ts": {
      "includeFiles": "src/public/**"
    }
  }
}